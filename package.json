{
  "name": "webcam-monitor",
  "version": "1.1.1",
  "description": "Webcam-Vorschau mit Tonwiedergabe für Capture-Karten",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "native:build": "dotnet publish native/DirectShowAudio/DirectShowAudio.csproj -c Release -o native/DirectShowAudio/publish",
    "test:update": "node scripts/test-update-check.js",
    "icons": "node scripts/prepare-icons.js",
    "build": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never"
  },
  "author": "JaTi Digital (jati-digital.de)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Antim8-23/webcam-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/Antim8-23/webcam-monitor/issues"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "de.webcam.monitor",
    "productName": "Webcam Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "native/DirectShowAudio/publish",
        "to": "native/DirectShowAudio/publish",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": true
    },
    "portable": {
      "artifactName": "WebcamMonitor-portable-v${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "WebcamMonitor-setup-v${version}.exe",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  }
}
