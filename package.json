{
  "name": "webcam-monitor",
  "version": "1.0.0",
  "description": "Webcam-Vorschau mit Tonwiedergabe für Capture-Karten",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/prepare-icons.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "author": "JaTi Digital (jati-digital.de)",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "de.webcam.monitor",
    "productName": "Webcam Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/icon.ico",
      "assets/icon.png",
      "LICENSE"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "WebcamMonitor-portable.exe"
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "WebcamMonitor-setup.exe"
    }
  }
}
